<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs apple/refresh.sh hourly. Installed as ~/Library/LaunchAgents/com.anuraagshankar.dualtranslator.refresh.plist -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.anuraagshankar.dualtranslator.refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/anuraagshankar/Projects/dual-translation/apple/refresh.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/anuraagshankar/Library/Logs/DualTranslatorRefresh.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/anuraagshankar/Library/Logs/DualTranslatorRefresh.log</string>
</dict>
</plist>
